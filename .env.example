# Copy this file to ".env" and fill in your real values.
# Never commit your real .env file (it's already in .gitignore).

# Your bot's token, from the Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Your application's Client ID, from Developer Portal -> General Information -> Application ID
CLIENT_ID=your-application-id-here

# The ID of YOUR server (guild). Right-click your server icon -> Copy Server ID
# (You must enable Developer Mode in Discord: User Settings -> Advanced -> Developer Mode)
# Used so the /play command appears instantly in your server while developing.
GUILD_ID=your-server-id-here

# OPTIONAL: Only let people with this role use /play. Leave blank to allow everyone.
# This is the @looking2play role you described (match the name exactly, no @).
REQUIRED_ROLE_NAME=looking2play

# OPTIONAL: Restrict /play to a single channel. Paste the channel ID, or leave blank
# to allow it anywhere. Right-click the #Looking-2-play channel -> Copy Channel ID.
LFG_CHANNEL_ID=
